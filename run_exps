./isaaclab.sh -p source/standalone/workflows/rsl_rl/train.py env.amp_motion_folder='datasets/mocap_AMP_for_hardware/*' agent.amp_motion_folder='datasets/mocap_AMP_for_hardware/*' --task Isaac-Velocity-AMPStairs-Unitree-Go2-v0 --headless --seed 3 --log_dir "${datetime}_paper_mocap" --logger wandb --log_project_name paper_mocap --max_iterations 25000
